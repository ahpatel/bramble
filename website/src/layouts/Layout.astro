---
import "@/styles/starwind.css";
import { SITE } from "@/consts";
import { WEBSITE_FLAGS, type WebsiteFlag } from "@/flags";

interface Props {
	title?: string;
	description?: string;
	/** Page path for the canonical URL, e.g. "/privacy". */
	path?: string;
	/** Hide this page behind a website flag: without it, a visitor lands on the home page. */
	flag?: WebsiteFlag;
}

const {
	title,
	description = SITE.description,
	path = "/",
	flag,
} = Astro.props;

// The sandbox build (`deploy:sandbox`) shows flagged pages and parts: the sandbox apps link
// straight to them.
const sandbox = import.meta.env.MODE === "sandbox";
const gate = sandbox ? undefined : flag;
// A part of a page marked `data-ff="name"` shows only while the tab has that flag.
const hideFlagged = sandbox
	? ""
	: WEBSITE_FLAGS.map((f) => `html:not([data-ff-on~="${f}"]) [data-ff="${f}"]{display:none!important}`).join("");
const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.tagline}`;
const canonical = new URL(path, SITE.url).href;
const ogImage = new URL("/icon-512.png", SITE.url).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="canonical" href={canonical} />
		<meta name="generator" content={Astro.generator} />

		<title>{pageTitle}</title>
		<meta name="description" content={description} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#242424" media="(prefers-color-scheme: dark)" />

		{flag && <meta name="robots" content="noindex" />}
		{gate && <noscript><meta http-equiv="refresh" content="0; url=/" /></noscript>}

		{/* Website flags, before first paint so a flagged page never flashes. `?ff=a,b` on any page
		    sets this tab's flags, and an empty value clears them. The tab keeps them, because
		    coming back from Stripe carries no query. */}
		<script is:inline define:vars={{ known: WEBSITE_FLAGS, required: gate ?? null }}>
			var key = "bramble.ff";
			var on = [];
			try {
				on = JSON.parse(sessionStorage.getItem(key)) || [];
			} catch (e) {}
			var given = new URLSearchParams(location.search).get("ff");
			if (given !== null) {
				on = given.split(",").filter(function (name) {
					return known.indexOf(name) !== -1;
				});
				try {
					sessionStorage.setItem(key, JSON.stringify(on));
				} catch (e) {}
			}
			document.documentElement.setAttribute("data-ff-on", on.join(" "));
			if (required && on.indexOf(required) === -1) {
				document.documentElement.style.display = "none";
				location.replace("/");
			}
		</script>

		{hideFlagged && <style is:inline set:html={hideFlagged} />}

		{/* Set the theme before first paint so there is no light/dark flash. Mirrors
		    the extension's behavior and reads the same `colorTheme` key the Starwind
		    ThemeToggle writes. `theme-ready` hands the background to the .dark class. */}
		<script is:inline>
			(function () {
				try {
					var stored = localStorage.getItem("colorTheme");
					var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
					var dark = stored
						? stored === "dark" || (stored === "system" && prefersDark)
						: prefersDark;
					document.documentElement.classList.toggle("dark", dark);
				} catch (e) {}
				document.documentElement.classList.add("theme-ready");
			})();
		</script>
	</head>
	<body class="min-h-screen antialiased">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-md focus:bg-background focus:px-3 focus:py-2 focus:text-sm focus:font-medium"
		>
			Skip to content
		</a>
		<slot />

		{/* Personalize the "Add to your browser" buttons: point them at the right store
		    and, where the browser is nameable, relabel to "Add to <Browser>". The markup
		    defaults to the Chrome Web Store and a generic label, so with JS off or an
		    unknown browser (Safari, Arc) it degrades cleanly. */}
		<script>
			import { LINKS } from "@/consts";
			import { browserName, detect } from "@/scripts/platform";

			const href = detect().family === "gecko" ? LINKS.firefox : LINKS.chrome;
			for (const el of document.querySelectorAll("[data-install-browser]")) {
				el.setAttribute("href", href);
			}

			// Resolved rather than read: Brave hides itself from the user agent string.
			browserName().then((name) => {
				if (!name) return;
				for (const el of document.querySelectorAll("[data-install-label]")) {
					el.textContent = `Add to ${name}`;
				}
			});
		</script>
	</body>
</html>
